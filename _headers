# Revalidate HTML and shared scripts/styles after deployments.
# Uploaded /img/* media retains its immutable Functions response headers.
/
  Cache-Control: no-cache
/:page
  Cache-Control: no-cache
/css/*
  Cache-Control: no-cache
/js/*
  Cache-Control: no-cache
/admin
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'; form-action 'self'; base-uri 'self'
  X-Content-Type-Options: nosniff
/admin.html
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'; form-action 'self'; base-uri 'self'
  X-Content-Type-Options: nosniff
